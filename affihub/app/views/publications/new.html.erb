<% content_for :title, "Create Publication" %>

<section class="w-full max-w-3xl space-y-5" aria-labelledby="new-publication-title">
  <header>
    <p class="text-sm font-medium text-muted">Facebook Page post</p>
    <h1 id="new-publication-title" class="mt-1 text-xl font-semibold text-foreground">Create Publication</h1>
    <p class="mt-1 text-sm text-muted">Choose an approved Content version and the Facebook Page that will receive it.</p>
  </header>

  <% if @contents.empty? || @destinations.empty? %>
    <section class="rounded-xl border border-border-strong bg-surface p-5">
      <h2 class="text-base font-semibold text-foreground">More setup needed</h2>
      <p class="mt-2 text-sm leading-5 text-muted"><%= @contents.empty? ? "Approve a Content version before creating a Publication." : "Connect and select a Facebook Page before creating a Publication." %></p>
      <% if @contents.empty? %>
        <%= link_to "Product Library", products_path, class: "mt-4 inline-flex min-h-10 items-center text-sm font-medium text-foreground underline decoration-border-strong underline-offset-4" %>
      <% else %>
        <%= link_to "Facebook Pages", facebook_pages_path, class: "mt-4 inline-flex min-h-10 items-center text-sm font-medium text-foreground underline decoration-border-strong underline-offset-4" %>
      <% end %>
    </section>
  <% else %>
    <%= form_with url: publications_path, method: :post, class: "space-y-4 rounded-xl border border-border-strong bg-surface p-4 sm:p-6" do |form| %>
      <div class="space-y-1.5">
        <%= form.label :content_id, "Approved Content", class: "block text-sm font-medium text-foreground" %>
        <%= form.select :content_id, options_from_collection_for_select(@contents, :id, ->(content) { "#{content.product.title} · #{content.created_at.to_date}" }, @selected_content_id), { include_blank: "Choose a Content version" }, required: true, class: "h-11 w-full rounded-xl border border-border-strong bg-surface px-3 text-base text-foreground focus:border-focus focus:outline-hidden focus:ring-2 focus:ring-focus md:text-sm" %>
      </div>
      <div class="space-y-1.5">
        <%= form.label :social_destination_id, "Facebook Page", class: "block text-sm font-medium text-foreground" %>
        <%= form.select :social_destination_id, options_from_collection_for_select(@destinations, :id, ->(destination) { "#{destination.name} · #{destination.page_id}" }), { include_blank: "Choose a Page" }, required: true, class: "h-11 w-full rounded-xl border border-border-strong bg-surface px-3 text-base text-foreground focus:border-focus focus:outline-hidden focus:ring-2 focus:ring-focus md:text-sm" %>
      </div>
      <%= form.submit "Create draft Publication", class: "inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl bg-primary px-5 py-2 text-sm font-medium text-primary-foreground hover:bg-primary-hover" %>
    <% end %>
  <% end %>
</section>
