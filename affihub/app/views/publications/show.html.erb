<% content_for :title, "Publication Status" %>
<% content = @publication.content %>
<% destination = @publication.social_destination %>
<% retryable = @publication.status_failed? || (@publication.status_publishing? && @publication.last_attempt_at && @publication.last_attempt_at < Publication::STALE_PUBLISHING_AFTER.ago) %>

<section class="w-full max-w-4xl space-y-5" aria-labelledby="publication-title">
  <header class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium text-muted">Facebook Page · <%= destination.name %></p>
      <h1 id="publication-title" class="mt-1 text-xl font-semibold text-foreground">Publication Status</h1>
      <p class="mt-1 text-sm text-muted">Status: <span class="font-semibold text-foreground"><%= @publication.status.humanize %></span></p>
    </div>
    <%= link_to "Create another Publication", new_publication_path, class: "inline-flex min-h-10 items-center justify-center rounded-xl border border-border-strong bg-surface px-4 py-2 text-sm font-medium text-foreground hover:bg-button-hover" %>
  </header>

  <article class="rounded-xl border border-border-strong bg-surface p-4 sm:p-6">
    <h2 class="text-sm font-semibold text-foreground"><%= content.product.title %></h2>
    <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-foreground"><%= content.body %></p>
    <% if content.affiliate_url.present? %>
      <p class="mt-3 break-all text-sm text-foreground"><%= content.affiliate_url %></p>
    <% end %>
  </article>

  <dl class="grid grid-cols-1 gap-4 rounded-xl border border-border-strong bg-surface p-4 sm:grid-cols-2 sm:p-5">
    <div><dt class="text-xs font-medium text-muted">Provider post ID</dt><dd class="mt-1 break-all text-sm text-foreground"><%= @publication.provider_post_id.presence || "—" %></dd></div>
    <div><dt class="text-xs font-medium text-muted">Published at</dt><dd class="mt-1 text-sm text-foreground"><%= @publication.published_at&.to_fs(:long) || "—" %></dd></div>
    <div class="sm:col-span-2"><dt class="text-xs font-medium text-muted">Published URL</dt><dd class="mt-1 break-all text-sm text-foreground"><%= @publication.published_url ? link_to(@publication.published_url, @publication.published_url, target: "_blank", rel: "noopener noreferrer", class: "underline decoration-border-strong underline-offset-4") : "—" %></dd></div>
    <% if @publication.error_code.present? || @publication.error_message.present? %>
      <div><dt class="text-xs font-medium text-muted">Error code</dt><dd class="mt-1 text-sm text-foreground"><%= @publication.error_code %></dd></div>
      <div><dt class="text-xs font-medium text-muted">Error</dt><dd class="mt-1 text-sm text-foreground"><%= @publication.error_message %></dd></div>
    <% end %>
  </dl>

  <% if @publication.status_draft? %>
    <div class="flex flex-col gap-3 rounded-xl border border-border-strong bg-surface p-4 sm:flex-row sm:items-end sm:justify-between sm:p-5">
      <%= button_to "Post now", post_now_publication_path(@publication), method: :post, class: "inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl bg-primary px-5 py-2 text-sm font-medium text-primary-foreground hover:bg-primary-hover" %>
      <%= form_with url: schedule_publication_path(@publication), method: :post, class: "flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:items-end" do |form| %>
        <div class="space-y-1.5"><%= form.label :scheduled_at, "Schedule for", class: "block text-xs font-medium text-muted" %><%= form.datetime_local_field :scheduled_at, value: 1.hour.from_now.strftime("%Y-%m-%dT%H:%M"), required: true, class: "h-11 rounded-xl border border-border-strong bg-surface px-3 text-base text-foreground md:text-sm" %></div>
        <%= form.submit "Schedule", class: "inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl border border-border-strong bg-surface px-4 py-2 text-sm font-medium text-foreground hover:bg-button-hover" %>
      <% end %>
    </div>
  <% end %>

  <% if retryable %>
    <% if @publication.ambiguous_outcome? %>
      <section data-controller="dialog">
        <button type="button" data-action="dialog#open" class="inline-flex min-h-11 items-center justify-center rounded-xl border border-border-strong bg-surface px-4 py-2 text-sm font-medium text-foreground hover:bg-button-hover">Retry Publication</button>
        <dialog data-dialog-target="dialog" class="w-[min(32rem,calc(100%-2rem))] rounded-xl border border-border-strong bg-surface p-0 text-foreground shadow-xl backdrop:bg-black/40">
          <div class="space-y-4 p-5">
            <h2 class="text-base font-semibold">Possible duplicate post</h2>
            <p class="text-sm leading-5 text-muted">Facebook may have accepted the earlier request before the connection failed. Retrying can publish a duplicate.</p>
            <div class="flex justify-end gap-2">
              <button type="button" data-action="dialog#close" class="inline-flex min-h-10 items-center justify-center rounded-xl border border-border-strong px-4 text-sm font-medium">Cancel</button>
              <%= button_to "Confirm retry", retry_publication_path(@publication), method: :post, params: { confirm_duplicate_risk: true }, class: "inline-flex min-h-10 cursor-pointer items-center justify-center rounded-xl bg-primary px-4 text-sm font-medium text-primary-foreground" %>
            </div>
          </div>
        </dialog>
      </section>
    <% else %>
      <%= button_to "Retry Publication", retry_publication_path(@publication), method: :post, class: "inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl border border-border-strong bg-surface px-4 py-2 text-sm font-medium text-foreground hover:bg-button-hover" %>
    <% end %>
  <% end %>
</section>
