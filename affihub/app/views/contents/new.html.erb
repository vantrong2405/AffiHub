<% content_for :title, "Generate Content · #{@product.title}" %>

<section class="w-full max-w-4xl space-y-5" aria-labelledby="generate-content-title">
  <%= link_to "← #{@product.title}", product_path(@product), class: "inline-flex min-h-10 items-center text-sm font-medium text-muted underline decoration-border-strong underline-offset-4 hover:text-foreground" %>
  <header>
    <p class="text-sm font-medium text-muted">New draft</p>
    <h1 id="generate-content-title" class="mt-1 text-xl font-semibold text-foreground">Generate Content</h1>
    <p class="mt-1 text-sm text-muted">Codex will draft copy from the product facts below. You review it before publishing.</p>
  </header>

  <article class="rounded-xl border border-border-strong bg-surface p-4 sm:p-6">
    <h2 class="text-base font-semibold text-foreground"><%= @product.title %></h2>
    <p class="mt-1 text-sm text-muted"><%= @product.merchant %><%= " · #{@product.category}" if @product.category.present? %></p>
    <dl class="mt-4 grid grid-cols-2 gap-4 border-t border-border-strong pt-4 sm:grid-cols-4">
      <div><dt class="text-xs text-muted">Price</dt><dd class="mt-1 text-sm font-medium text-foreground"><%= @product.price ? number_to_currency(@product.price, unit: "₫", precision: 0, delimiter: ".", format: "%n %u") : "—" %></dd></div>
      <div><dt class="text-xs text-muted">Rating</dt><dd class="mt-1 text-sm font-medium text-foreground"><%= @product.rating || "—" %></dd></div>
      <div><dt class="text-xs text-muted">Sold</dt><dd class="mt-1 text-sm font-medium text-foreground"><%= @product.sold ? number_with_delimiter(@product.sold, delimiter: ".") : "—" %></dd></div>
      <div><dt class="text-xs text-muted">Discount</dt><dd class="mt-1 text-sm font-medium text-foreground"><%= @product.discount ? number_to_percentage(@product.discount, precision: 0) : "—" %></dd></div>
    </dl>
  </article>

  <%= form_with url: contents_path, method: :post, class: "flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" do |form| %>
    <%= form.hidden_field :product_id, value: @product.id %>
    <%= form.submit "Generate new draft", class: "inline-flex min-h-11 cursor-pointer items-center justify-center rounded-xl bg-primary px-5 py-2 text-sm font-medium text-primary-foreground hover:bg-primary-hover" %>
    <%= link_to "View previous Content", contents_path(product_id: @product.id), class: "inline-flex min-h-11 items-center justify-center rounded-xl border border-border-strong bg-surface px-4 py-2 text-sm font-medium text-foreground hover:bg-button-hover" %>
  <% end %>
</section>
