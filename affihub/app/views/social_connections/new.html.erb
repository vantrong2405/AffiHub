<% content_for :title, "Kết nối Facebook" %>

<section class="mx-auto max-w-3xl space-y-6">
  <div class="space-y-2">
    <%= link_to "← Danh sách tài khoản", social_connections_path, class: "link link-hover text-sm" %>
    <h1 class="text-3xl font-bold">Kết nối Facebook</h1>
    <p class="text-base-content/70">Chọn profile rồi tiếp tục chọn các Page bạn muốn đăng video.</p>
  </div>

  <article class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body gap-4">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 class="card-title">Facebook</h2>
          <p class="text-sm text-base-content/60">AffiHub chỉ lưu credential đã mã hóa và không hiển thị token.</p>
        </div>
        <% if @provider_configured %>
          <span class="badge badge-success">Sẵn sàng kết nối</span>
        <% else %>
          <span class="badge badge-warning">Chưa cấu hình</span>
        <% end %>
      </div>

      <% if @provider_configured %>
        <div role="status" class="alert alert-info">
          <span>Bạn sẽ được chuyển sang Facebook để xác nhận quyền truy cập.</span>
        </div>
        <%= button_to "Tiếp tục với Facebook", social_connections_path(provider: @provider), method: :post, class: "btn btn-primary w-full sm:w-auto" %>
      <% else %>
        <div role="alert" class="alert alert-warning">
          <span>Chưa có Meta App ID. Hãy cấu hình META_APP_ID để bắt đầu kết nối.</span>
        </div>
        <button type="button" class="btn btn-primary w-full sm:w-auto" disabled>Kết nối Facebook</button>
      <% end %>
    </div>
  </article>
</section>
