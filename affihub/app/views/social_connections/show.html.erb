<% provider_name = social_provider_name(@social_connection.provider) %>
<% is_instagram = @social_connection.provider == "instagram" %>
<% destination_name = is_instagram ? "tài khoản Instagram Business" : social_destination_name(@social_connection.provider) %>
<% content_for :title, "#{@social_connection.name} | Kết nối #{provider_name}" %>

<section class="space-y-6">
  <div class="space-y-2">
    <%= link_to "← Danh sách tài khoản", social_connections_path, class: "link link-hover text-sm" %>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold"><%= @social_connection.name %></h1>
        <p class="mt-1 text-sm text-base-content/60"><%= provider_name %> · ID <%= @social_connection.external_user_id %></p>
      </div>
      <% if social_destination_selection_supported?(@social_connection.provider) %>
        <%= link_to "Chọn #{destination_name}", social_connection_social_destinations_path(@social_connection), class: "btn btn-primary w-full sm:w-auto" %>
      <% end %>
    </div>
  </div>

  <div class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body gap-4">
      <div class="flex items-center justify-between gap-3">
        <h2 class="card-title">Tài khoản <%= provider_name %></h2>
        <%= workflow_status_badge(@social_connection.status, resource: "social_connection") %>
      </div>
      <p class="text-sm text-base-content/60">Token được mã hóa khi lưu và không hiển thị trên trang này.</p>
    </div>
  </div>

  <div class="space-y-3">
    <h2 class="text-xl font-semibold"><%= is_instagram ? "Instagram Business account đã chọn" : "#{destination_name.capitalize} đã chọn" %></h2>
    <% if @social_destinations.any? %>
      <div class="grid gap-4 md:grid-cols-2">
        <% @social_destinations.each do |social_destination| %>
          <article class="card border border-base-300 bg-base-100 shadow-sm">
            <div class="card-body gap-3">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="card-title text-base"><%= social_destination.name %></h3>
                  <% if is_instagram %>
                    <% destination_metadata = social_destination.metadata.to_h.stringify_keys %>
                    <p class="text-sm text-base-content/60">Instagram Business account ID <%= social_destination.external_id %></p>
                    <p class="text-sm text-base-content/60">Page ID <%= destination_metadata["page_id"] %></p>
                    <p class="text-sm text-base-content/60">Loại tài khoản Instagram <%= destination_metadata["instagram_account_type"] %></p>
                  <% else %>
                    <p class="text-sm text-base-content/60">Page ID <%= social_destination.external_id %></p>
                  <% end %>
                </div>
                <%= workflow_status_badge(social_destination.status, resource: "social_destination") %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="card border border-dashed border-base-300 bg-base-100">
        <div class="card-body items-start">
          <h3 class="card-title">Chưa chọn <%= destination_name %></h3>
          <p class="text-base-content/70">Chọn <%= destination_name %> bạn muốn dùng làm đích đăng.</p>
          <% if social_destination_selection_supported?(@social_connection.provider) %>
            <%= link_to "Chọn #{destination_name}", social_connection_social_destinations_path(@social_connection), class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
