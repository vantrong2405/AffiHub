<%= form_with url: login_path, method: :post, local: true, class: "flex flex-col gap-4" do %>
  <div class="flex flex-col gap-1.5">
    <label for="email" class="text-sm font-medium text-foreground">Email</label>
    <input type="email" name="email" id="email" required autofocus
           autocomplete="username" class="min-h-11 rounded-lg border border-border-strong bg-surface px-3 text-sm text-foreground focus:border-focus focus:outline-hidden focus:ring-2 focus:ring-focus">
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="password" class="text-sm font-medium text-foreground">Mật khẩu</label>
    <input type="password" name="password" id="password" required
           autocomplete="current-password" class="min-h-11 rounded-lg border border-border-strong bg-surface px-3 text-sm text-foreground focus:border-focus focus:outline-hidden focus:ring-2 focus:ring-focus">
  </div>

  <button type="submit"
          class="mt-2 min-h-11 rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary-hover">
    Đăng nhập
  </button>
<% end %>
