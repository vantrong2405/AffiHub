<% content_for :title, "Nguồn video | #{@video_project.name}" %>

<section class="space-y-6">
  <div class="space-y-2">
    <%= link_to "← #{@video_project.name}", video_project_path(@video_project), class: "link link-hover text-sm" %>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold">Nguồn video</h1>
        <p class="text-base-content/70">Theo dõi file, URL và kết quả YouTube của project.</p>
      </div>
      <%= link_to "Thêm nguồn video", new_video_project_source_asset_path(@video_project), class: "btn btn-primary w-full sm:w-auto" %>
    </div>
  </div>

  <% if @source_assets.any? %>
    <ul class="divide-y divide-base-300 rounded-box border border-base-300 bg-base-100">
      <% @source_assets.each do |source_asset| %>
        <li class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
          <div class="min-w-0 space-y-1">
            <h2 class="break-all font-semibold"><%= source_asset.file.attached? ? source_asset.file.filename : source_asset.source_url.presence || "Video import" %></h2>
            <p class="text-sm text-base-content/60"><%= l(source_asset.created_at, format: :short) %></p>
          </div>
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
            <%= workflow_status_badge(source_asset.status, resource: "source_asset") %>
            <%= link_to "Xem trạng thái", video_project_source_asset_path(@video_project, source_asset), class: "btn btn-outline btn-sm w-full sm:w-auto" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="card border border-dashed border-base-300 bg-base-100">
      <div class="card-body items-start">
        <h2 class="card-title">Project chưa có video nguồn</h2>
        <p class="text-base-content/70">Nhập file MP4/MOV, dán URL hoặc tìm metadata YouTube.</p>
        <%= link_to "Thêm nguồn video", new_video_project_source_asset_path(@video_project), class: "btn btn-primary w-full sm:w-auto" %>
      </div>
    </div>
  <% end %>
</section>
