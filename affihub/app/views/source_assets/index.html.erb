<% content_for :title, "Source video | #{@video_project.name}" %>

<section class="space-y-6">
  <div class="space-y-2">
    <%= link_to "← #{@video_project.name}", video_project_path(@video_project), class: "link link-hover text-sm" %>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold">Source video</h1>
        <p class="text-base-content/70">Theo dõi trạng thái import và kiểm tra file.</p>
      </div>
      <%= link_to "Nhập video", new_video_project_source_asset_path(@video_project), class: "btn btn-primary w-full sm:w-auto" %>
    </div>
  </div>

  <% if @source_assets.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @source_assets.each do |source_asset| %>
        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0 space-y-1">
                <h2 class="card-title break-all text-base"><%= source_asset.file.attached? ? source_asset.file.filename : "Video import" %></h2>
                <p class="text-sm text-base-content/60"><%= l(source_asset.created_at, format: :short) %></p>
              </div>
              <%= workflow_status_badge(source_asset.status, resource: "source_asset") %>
            </div>
            <div class="card-actions justify-end">
              <%= link_to "Xem trạng thái", video_project_source_asset_path(@video_project, source_asset), class: "btn btn-outline btn-sm" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="card border border-dashed border-base-300 bg-base-100">
      <div class="card-body items-start">
        <h2 class="card-title">Chưa có source video</h2>
        <p class="text-base-content/70">Nhập một file MP4 hoặc MOV để xem trạng thái kiểm tra tại đây.</p>
        <%= link_to "Nhập video", new_video_project_source_asset_path(@video_project), class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</section>
