<% content_for :title, "Dự án video | AffiHub" %>

<section class="space-y-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="space-y-2">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">Workspace video</p>
      <h1 class="text-3xl font-bold">Dự án video</h1>
      <p class="max-w-2xl text-base-content/70">Tạo project để nhập video, kiểm tra file và tiếp tục biên tập trên máy này.</p>
    </div>
    <%= link_to "Tạo project", new_video_project_path, class: "btn btn-primary w-full sm:w-auto" %>
  </div>

  <% if @video_projects.any? %>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% @video_projects.each do |video_project| %>
        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-5">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0 space-y-1">
                <h2 class="card-title break-words"><%= video_project.name %></h2>
                <p class="text-sm text-base-content/60">Cập nhật <%= l(video_project.updated_at, format: :short) %></p>
              </div>
              <%= workflow_status_badge(video_project.status, resource: "video_project") %>
            </div>
            <div class="card-actions justify-end">
              <%= link_to "Mở project", video_project_path(video_project), class: "btn btn-outline btn-sm" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="card border border-dashed border-base-300 bg-base-100">
      <div class="card-body items-start gap-4 sm:p-8">
        <div class="space-y-2">
          <h2 class="card-title">Chưa có project</h2>
          <p class="max-w-xl text-base-content/70">Bắt đầu bằng một project. Sau đó bạn có thể nhập file MP4 hoặc MOV và theo dõi kết quả kiểm tra tại đây.</p>
        </div>
        <%= link_to "Tạo project đầu tiên", new_video_project_path, class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</section>
