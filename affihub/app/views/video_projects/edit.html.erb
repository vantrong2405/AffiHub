<% content_for :title, "Đổi tên project | AffiHub" %>

<section class="mx-auto max-w-2xl space-y-6">
  <div class="space-y-2">
    <%= link_to "← #{@video_project.name}", video_project_path(@video_project), class: "link link-hover text-sm" %>
    <h1 class="text-3xl font-bold">Đổi tên project</h1>
    <p class="text-base-content/70">Các source và render hiện có vẫn thuộc project này.</p>
  </div>

  <%= render "form", video_project: @video_project, submit_label: "Lưu thay đổi" %>
</section>
