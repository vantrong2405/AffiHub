<% content_for :title, "Bản render | #{@video_project.name}" %>

<section class="mx-auto max-w-5xl space-y-6">
  <div class="space-y-3">
    <%= link_to "← #{@video_project.name}", video_project_path(@video_project), class: "link link-hover text-sm" %>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold">Bản render</h1>
        <p class="mt-1 text-sm text-base-content/60">Mỗi lần render tạo một file MP4 riêng và giữ nguyên version cũ.</p>
      </div>
      <% if @video_project.source_assets.ready.exists? %>
        <%= link_to "Biên tập video", new_video_project_render_version_path(@video_project), class: "btn btn-primary w-full sm:w-auto" %>
      <% end %>
    </div>
  </div>

  <% if @render_versions.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @render_versions.each do |render_version| %>
        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h2 class="card-title">Version <%= render_version.version_number %></h2>
                <p class="text-sm text-base-content/60"><%= render_version.source_asset.file.filename if render_version.source_asset.file.attached? %></p>
                <p class="text-sm text-base-content/60"><%= l(render_version.created_at, format: :short) %></p>
              </div>
              <%= workflow_status_badge(render_version.status, resource: "render_version") %>
            </div>
            <div class="card-actions justify-end">
              <%= link_to "Xem bản render", video_project_render_version_path(@video_project, render_version), class: "btn btn-outline btn-sm" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-box border border-dashed border-base-300 bg-base-100 p-8 text-center">
      <h2 class="text-lg font-semibold">Chưa có bản render</h2>
      <% if @video_project.source_assets.ready.exists? %>
        <p class="mt-2 text-sm text-base-content/70">Chọn một source sẵn sàng để mở editor và tạo version đầu tiên.</p>
        <%= link_to "Biên tập video", new_video_project_render_version_path(@video_project), class: "btn btn-primary mt-4" %>
      <% else %>
        <p class="mt-2 text-sm text-base-content/70">Nhập và kiểm tra một file video trước khi mở editor.</p>
        <%= link_to "Nhập video", new_video_project_source_asset_path(@video_project), class: "btn btn-primary mt-4" %>
      <% end %>
    </div>
  <% end %>
</section>
