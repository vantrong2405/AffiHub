<% content_for :title, "Kết quả YouTube | #{@video_project.name}" %>

<section class="mx-auto max-w-5xl space-y-6">
  <div class="space-y-2">
    <%= link_to "← #{@video_project.name}", video_project_path(@video_project), class: "link link-hover text-sm" %>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div class="space-y-1">
        <h1 class="text-3xl font-bold">Kết quả YouTube</h1>
        <% if @source_discovery.search_type == "keyword" %>
          <p class="text-base-content/70">Từ khóa: <span class="font-medium"><%= @source_discovery.search_query %></span></p>
        <% else %>
          <% region_label = @regions[@source_discovery.region_code.to_sym] || @source_discovery.region_code %>
          <% category_label = @video_categories[@source_discovery.video_category_id.to_s.to_sym] || "Tất cả danh mục" %>
          <p class="text-base-content/70">Video phổ biến · <%= region_label %> · <%= category_label %></p>
        <% end %>
      </div>
      <%= link_to "Tìm video khác", new_video_project_source_discovery_path(@video_project), class: "btn btn-outline w-full sm:w-auto" %>
    </div>
  </div>

  <div class="alert alert-warning items-start" role="note">
    <span>Metadata có attribution tới YouTube. Việc chọn kết quả không cấp quyền tải hay sử dụng video. Hãy xác nhận quyền và điều khoản trước khi gửi yêu cầu tải.</span>
  </div>

  <% if @search_results.any? %>
    <ol class="divide-y divide-base-300 rounded-box border border-base-300 bg-base-100">
      <% @search_results.each do |result| %>
        <% metadata = result.youtube_discovery_metadata %>
        <li class="flex flex-col gap-4 p-4 sm:flex-row sm:items-start sm:px-5">
          <%= image_tag metadata.thumbnail_url,
                        alt: "Hình thu nhỏ: #{metadata.title}",
                        class: "aspect-video w-full rounded-box bg-base-200 object-cover ring-1 ring-base-300 sm:w-52",
                        loading: "lazy",
                        referrerpolicy: "no-referrer" %>
          <div class="min-w-0 flex-1 space-y-3">
            <div class="space-y-1">
              <h2 class="line-clamp-2 text-base font-semibold"><%= metadata.title %></h2>
              <p class="text-sm text-base-content/70">Kênh: <%= metadata.channel_title %></p>
              <%= link_to "Mở video gốc trên YouTube ↗",
                          metadata.attribution_url,
                          class: "link link-hover text-sm",
                          target: "_blank",
                          rel: "noopener noreferrer" %>
            </div>

            <%= form_with url: video_project_source_assets_path(@video_project), scope: :source_asset, class: "space-y-3 border-t border-base-300 pt-3" do |form| %>
              <%= form.hidden_field :source_discovery_id, value: @source_discovery.id %>
              <%= form.hidden_field :youtube_discovery_metadata_id, value: metadata.id %>
              <label class="label min-w-0 cursor-pointer items-start justify-start gap-3">
                <%= form.check_box :rights_confirmed, { required: true, class: "checkbox checkbox-primary mt-1" }, "1", "0" %>
                <span class="min-w-0 flex-1 break-words whitespace-normal text-sm">Tôi có quyền sử dụng video này và đã kiểm tra điều khoản của nguồn.</span>
              </label>
              <%= form.submit "Chọn video và thử tải", class: "btn btn-primary h-11 min-h-11 w-full md:h-10 md:min-h-10 sm:w-auto", data: { turbo_submits_with: "Đang gửi yêu cầu…" } %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <div class="card border border-dashed border-base-300 bg-base-100">
      <div class="card-body items-start">
        <h2 class="card-title">Chưa có video khớp tìm kiếm</h2>
        <p class="text-base-content/70">Thử từ khóa khác hoặc nhập URL video cụ thể.</p>
        <%= link_to "Tìm lại", new_video_project_source_discovery_path(@video_project), class: "btn btn-primary w-full sm:w-auto" %>
      </div>
    </div>
  <% end %>
</section>
