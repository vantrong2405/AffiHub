<%= form_with model: auto_reply_rule, class: "card border border-base-300 bg-base-100" do |form| %>
  <div class="card-body gap-5 p-4 sm:p-6">
    <div role="status" class="alert alert-info">
      <span>AffiHub gửi nguyên văn câu đã lưu; quy tắc không dùng AI để soạn hoặc bổ sung nội dung.</span>
    </div>

    <% if editing %>
      <div class="form-control w-full">
        <span class="label-text mb-1 font-medium">Đích nhận bình luận</span>
        <p class="rounded-box border border-base-300 bg-base-200 px-3 py-2.5">
          <%= auto_reply_destination_label(auto_reply_rule.social_destination) %>
        </p>
      </div>
    <% else %>
      <label class="form-control w-full">
        <span class="label-text mb-1">Đích nhận bình luận</span>
        <%= form.select :social_destination_id,
                        options_for_select(
                          auto_reply_destination_options(social_destinations),
                          auto_reply_rule.social_destination_id
                        ),
                        { prompt: "Chọn Page hoặc tài khoản Instagram" },
                        required: true,
                        class: "select select-bordered w-full text-base" %>
        <span class="label-text-alt mt-1">Mỗi đích nhận bình luận chỉ có một câu trả lời mặc định đang bật.</span>
      </label>
    <% end %>

    <label class="form-control w-full">
      <span class="label-text mb-1">Loại quy tắc</span>
      <%= form.select :rule_type,
                      options_for_select(auto_reply_rule_type_options, auto_reply_rule.rule_type),
                      {},
                      required: true,
                      class: "select select-bordered w-full text-base" %>
    </label>

    <label class="form-control w-full">
      <span class="label-text mb-1">Từ khóa</span>
      <%= form.text_field :keyword, class: "input input-bordered w-full text-base" %>
      <span class="label-text-alt mt-1">Chỉ dùng với quy tắc theo từ khóa; AffiHub bỏ khoảng trắng đầu/cuối và so khớp không phân biệt hoa thường.</span>
    </label>

    <label class="form-control w-full">
      <span class="label-text mb-1">Câu trả lời</span>
      <%= form.text_area :reply_text, rows: 4, required: true, class: "textarea textarea-bordered w-full text-base" %>
      <span class="label-text-alt mt-1">Nội dung này được gửi nguyên văn khi quy tắc khớp.</span>
    </label>

    <label class="flex items-start gap-3 rounded-box border border-base-300 p-3">
      <%= form.check_box :enabled, class: "checkbox checkbox-primary mt-0.5" %>
      <span class="min-w-0">
        <span class="block font-medium">Bật quy tắc</span>
        <span class="block text-sm text-base-content/70">Câu mặc định đang bật sẽ đăng ký webhook bình luận trên Meta.</span>
      </span>
    </label>

    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <% if editing %>
        <%= link_to "Hủy", auto_reply_rule_path(auto_reply_rule), class: "btn btn-ghost w-full sm:w-auto" %>
      <% else %>
        <%= link_to "Hủy", auto_reply_rules_path, class: "btn btn-ghost w-full sm:w-auto" %>
      <% end %>
      <%= form.submit editing ? "Lưu thay đổi" : "Lưu quy tắc",
                       class: "btn btn-primary min-h-11 w-full md:min-h-10 sm:w-auto",
                       data: { turbo_submits_with: "Đang lưu…" } %>
    </div>
  </div>
<% end %>
