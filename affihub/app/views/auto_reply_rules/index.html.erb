<% content_for :title, "Tự trả lời bình luận" %>

<section class="space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-2">
      <h1 class="text-3xl font-bold">Tự trả lời bình luận</h1>
      <p class="max-w-2xl text-sm text-base-content/70">
        Cấu hình câu trả lời cố định cho bình luận công khai trên Facebook và Instagram. AffiHub không dùng AI để soạn câu trả lời.
      </p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row">
      <%= link_to "Xem nhật ký", auto_reply_logs_path, class: "btn btn-outline w-full sm:w-auto" %>
      <%= link_to "Thêm quy tắc", new_auto_reply_rule_path, class: "btn btn-primary w-full sm:w-auto" %>
    </div>
  </div>

  <% if auto_reply_rules_present?(@auto_reply_rules) %>
    <section class="card border border-base-300 bg-base-100" aria-labelledby="auto-reply-rules-heading">
      <div class="card-body gap-0 p-0">
        <h2 id="auto-reply-rules-heading" class="px-4 py-4 font-semibold sm:px-5">Quy tắc theo đích nhận bình luận</h2>
        <ul class="divide-y divide-base-300 border-t border-base-300">
          <% @auto_reply_rules.each do |auto_reply_rule| %>
            <li class="flex min-w-0 flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
              <div class="min-w-0 space-y-2">
                <div class="flex min-w-0 flex-wrap items-center gap-2">
                  <h3 class="min-w-0 break-words font-semibold">
                    <%= auto_reply_destination_label(auto_reply_rule.social_destination) %>
                  </h3>
                  <span class="badge badge-outline"><%= auto_reply_rule_type_label(auto_reply_rule.rule_type) %></span>
                  <span class="badge <%= auto_reply_rule_status_badge_class(auto_reply_rule) %>">
                    <%= auto_reply_rule_status_label(auto_reply_rule) %>
                  </span>
                </div>
                <% if auto_reply_rule_keyword_present?(auto_reply_rule) %>
                  <p class="text-sm text-base-content/70"><span class="font-medium"><%= auto_reply_rule_keyword_caption(auto_reply_rule) %></span></p>
                <% end %>
                <p class="line-clamp-2 break-words text-sm text-base-content/70"><%= auto_reply_rule.reply_text %></p>
              </div>
              <%= link_to "Mở quy tắc", auto_reply_rule_path(auto_reply_rule), class: "btn btn-outline w-full sm:w-auto" %>
            </li>
          <% end %>
        </ul>
      </div>
    </section>
  <% else %>
    <section class="card border border-base-300 bg-base-100" aria-labelledby="auto-reply-empty-heading">
      <div class="card-body items-start gap-3 p-4 sm:p-6">
        <h2 id="auto-reply-empty-heading" class="card-title">Chưa có quy tắc trả lời</h2>
        <p class="max-w-2xl text-sm text-base-content/70">
          Tạo một câu trả lời mặc định cho mỗi Page hoặc tài khoản Instagram đang kết nối. Có thể thêm quy tắc theo từ khóa sau đó.
        </p>
        <%= link_to "Tạo quy tắc đầu tiên", new_auto_reply_rule_path, class: "btn btn-primary w-full sm:w-auto" %>
      </div>
    </section>
  <% end %>
</section>
