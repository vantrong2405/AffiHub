<% content_for :title, "Tài khoản AI | AffiHub" %>
<% provider_copy = ai_provider_copy(provider: @ai_provider_connection.provider, display_name: @provider_presentation.fetch(:display_name)) %>
<% permission_copy = provider_copy.fetch(:permissions) %>
<% model_catalog = provider_copy.fetch(:model_catalog) %>

<section class="mx-auto max-w-4xl space-y-6">
  <div class="space-y-2">
    <%= link_to "← Danh sách tài khoản AI", ai_provider_connections_path, class: "link link-hover text-sm" %>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div class="min-w-0">
        <p class="text-sm text-base-content/60"><%= @provider_presentation.fetch(:display_name) %></p>
        <h1 class="break-words text-3xl font-bold"><%= @ai_provider_connection.display_name.presence || @ai_provider_connection.account_email %></h1>
        <p class="break-all text-sm text-base-content/60"><%= @ai_provider_connection.account_email %></p>
      </div>
      <%= workflow_status_badge(@ai_provider_connection.status, resource: "ai_provider_connection") %>
    </div>
  </div>

  <% if @ai_provider_connection.pending_verification? %>
    <div class="alert alert-warning" role="status">
      <div>
        <h2 class="font-semibold"><%= provider_copy.fetch(:pending_verification).fetch(:heading) %></h2>
        <p class="text-sm"><%= provider_copy.fetch(:pending_verification).fetch(:detail) %></p>
      </div>
    </div>
  <% elsif @ai_provider_connection.scope_missing? %>
    <div class="alert alert-warning" role="status">
      <div>
        <h2 class="font-semibold"><%= provider_copy.fetch(:scope_missing).fetch(:heading) %></h2>
        <p class="text-sm"><%= provider_copy.fetch(:scope_missing).fetch(:detail) %></p>
      </div>
    </div>
  <% elsif @ai_provider_connection.reauth_required? %>
    <div class="alert alert-error" role="alert">
      <div>
        <h2 class="font-semibold">Cần đăng nhập lại</h2>
        <p class="text-sm">Token hiện tại không còn được provider chấp nhận.</p>
      </div>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <article class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body gap-2">
        <h2 class="card-title text-base">Quyền sử dụng</h2>
        <% has_required_scopes = (@provider_presentation.fetch(:required_scopes) - @ai_provider_connection.scopes).empty? %>
        <p class="text-sm"><%= has_required_scopes ? permission_copy.fetch(:granted) : permission_copy.fetch(:missing) %></p>
        <p class="text-xs text-base-content/60"><%= permission_copy.fetch(:detail) %></p>
      </div>
    </article>

    <article class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body gap-2">
        <h2 class="card-title text-base">Token và dữ liệu tài khoản</h2>
        <p class="text-sm">Access token, refresh token và ID token được mã hóa trong database local.</p>
        <p class="text-xs text-base-content/60">Token không được đưa vào HTML, form hoặc log. Lần xác minh gần nhất: <%= @ai_provider_connection.last_verified_at ? l(@ai_provider_connection.last_verified_at, format: :short) : "Chưa có" %>.</p>
      </div>
    </article>
  </div>

  <% if @provider_presentation.fetch(:model_selection_enabled) %>
    <section class="card border border-base-300 bg-base-100 shadow-sm" aria-labelledby="provider-models-heading">
    <div class="card-body gap-4">
      <div>
        <h2 id="provider-models-heading" class="card-title"><%= model_catalog.fetch(:heading) %></h2>
        <p class="text-sm text-base-content/60"><%= model_catalog.fetch(:detail) %></p>
      </div>
      <% if @ai_provider_connection.available_models.any? %>
        <%= form_with model: @ai_provider_connection, url: ai_provider_connection_path(@ai_provider_connection), method: :patch, class: "flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
          <div class="form-control w-full">
            <%= form.label :selected_model, "Model sử dụng", class: "label" %>
            <%= form.select :selected_model,
                            options_for_select(@ai_provider_connection.available_models.map { |model| [ model.fetch("display_name"), model.fetch("slug") ] }, @ai_provider_connection.selected_model),
                            { include_blank: "Chọn model" },
                            class: "select select-bordered w-full" %>
          </div>
          <%= form.submit "Lưu model", class: "btn btn-primary w-full sm:w-auto" %>
        <% end %>
      <% else %>
        <div class="alert alert-info" role="status">
          <p><%= model_catalog.fetch(:empty) %></p>
        </div>
      <% end %>
    </div>
    </section>
  <% else %>
    <section class="card border border-base-300 bg-base-100 shadow-sm" aria-labelledby="provider-models-heading">
      <div class="card-body gap-2">
        <h2 id="provider-models-heading" class="card-title"><%= model_catalog.fetch(:heading) %></h2>
        <p class="text-sm text-base-content/70"><%= model_catalog.fetch(:detail) %></p>
      </div>
    </section>
  <% end %>

  <section class="card border border-base-300 bg-base-100 shadow-sm">
    <div class="card-body gap-4">
      <h2 class="card-title">Quản lý kết nối</h2>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <% if @ai_provider_connection.scope_missing? || @ai_provider_connection.reauth_required? %>
          <% if @callback_origin_matches %>
            <%= button_to "Đăng nhập lại", ai_provider_connections_path,
                          params: {
                            provider: @ai_provider_connection.provider,
                            ai_provider_connection_id: @ai_provider_connection.id
                          },
                          class: "btn btn-primary w-full sm:w-auto" %>
          <% else %>
            <%= link_to "Mở AffiHub",
                        "#{@callback_origin}#{ai_provider_connection_path(@ai_provider_connection)}",
                        class: "btn btn-primary w-full sm:w-auto" %>
            <p class="text-sm text-base-content/60">Callback: <code class="break-all"><%= @callback_origin %></code></p>
          <% end %>
        <% end %>
        <%= button_to "Ngắt kết nối", ai_provider_connection_path(@ai_provider_connection),
                      method: :delete,
                      class: "btn btn-error btn-outline w-full sm:w-auto",
                      data: { turbo_confirm: "Ngắt kết nối sẽ xóa token khỏi database local. Tiếp tục?" } %>
      </div>
    </div>
  </section>
</section>
