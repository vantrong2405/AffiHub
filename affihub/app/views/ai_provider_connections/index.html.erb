<% content_for :title, "Tài khoản AI | AffiHub" %>

<section class="space-y-8">
  <div class="space-y-2">
    <%= link_to "← Quay lại project", video_projects_path, class: "link link-hover text-sm" %>
    <h1 class="text-3xl font-bold">Tài khoản AI</h1>
    <p class="max-w-3xl text-base-content/70">
      Kết nối tài khoản để tạo kịch bản và gợi ý cảnh. AffiHub lưu token mã hóa trên máy này; token không hiển thị trong trang hoặc nhật ký.
    </p>
  </div>

  <section class="space-y-4" aria-labelledby="ai-provider-options-heading">
    <div>
      <h2 id="ai-provider-options-heading" class="text-xl font-semibold">Chọn tài khoản</h2>
      <p class="mt-1 text-sm text-base-content/60">Mở đúng địa chỉ callback trong từng thẻ để giữ cùng phiên đăng nhập.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <% @provider_options.each do |provider_option| %>
        <article class="card border border-base-300 bg-base-100 shadow-sm">
          <div class="card-body gap-4">
            <div class="flex items-start justify-between gap-2">
              <h3 class="card-title text-base"><%= provider_option.fetch(:label) %></h3>
              <% if provider_option.fetch(:enabled) %>
                <span class="badge badge-neutral badge-outline">Có thể kết nối</span>
              <% else %>
                <span class="badge badge-neutral badge-outline">Chưa khả dụng</span>
              <% end %>
            </div>
            <p class="min-h-12 text-sm text-base-content/70"><%= provider_option.fetch(:note) %></p>

            <% if provider_option.fetch(:enabled) && provider_option.fetch(:origin_matches) %>
              <% provider_key = provider_option.fetch(:provider, provider_option.fetch(:key)) %>
              <%= button_to "Tiếp tục với ChatGPT", ai_provider_connections_path,
                            params: { provider: provider_key },
                            class: "btn btn-primary w-full" if provider_key == "openai" %>
              <%= button_to "Kết nối Codex", ai_provider_connections_path,
                            params: { provider: provider_key },
                            class: "btn btn-primary w-full" if provider_key == "codex" %>
              <%= button_to "Kết nối Gemini", ai_provider_connections_path,
                            params: { provider: provider_key },
                            class: "btn btn-primary w-full" if provider_key == "gemini" %>
            <% elsif provider_option.fetch(:enabled) %>
              <% required_origin = provider_option.fetch(:required_origin) %>
              <%= link_to "Mở AffiHub",
                          "#{required_origin}#{ai_provider_connections_path}",
                          class: "btn btn-outline w-full" %>
              <p class="text-xs text-base-content/60">Callback: <code class="break-all"><%= required_origin %></code></p>
            <% else %>
              <button type="button" class="btn btn-disabled w-full" disabled>Chưa khả dụng</button>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </section>

  <section class="space-y-4" aria-labelledby="connected-ai-accounts-heading">
    <div>
      <h2 id="connected-ai-accounts-heading" class="text-xl font-semibold">Tài khoản đã kết nối</h2>
      <p class="mt-1 text-sm text-base-content/60">ChatGPT và Codex là hai kết nối riêng. Codex chỉ xác minh đăng nhập; Gemini chờ kiểm tra quyền API và hạn mức.</p>
    </div>

    <% if @ai_provider_connections.any? %>
      <div class="grid gap-4 md:grid-cols-2">
        <% @ai_provider_connections.each do |ai_provider_connection| %>
          <article class="card border border-base-300 bg-base-100 shadow-sm">
            <div class="card-body gap-4">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 space-y-1">
                  <h3 class="card-title break-words text-base"><%= ai_provider_connection.display_name.presence || ai_provider_connection.account_email %></h3>
                  <p class="break-all text-sm text-base-content/60">
                    <%= { "openai" => "ChatGPT", "codex" => "Codex", "gemini" => "Gemini API" }.fetch(ai_provider_connection.provider) %>
                    <% if ai_provider_connection.account_email.present? %> · <%= ai_provider_connection.account_email %><% end %>
                  </p>
                </div>
                <%= workflow_status_badge(ai_provider_connection.status, resource: "ai_provider_connection") %>
              </div>
              <p class="text-sm text-base-content/70">
                <% if ai_provider_connection.provider == "gemini" && ai_provider_connection.scope_missing? %>
                  Tài khoản chưa cấp scope Gemini API cần thiết.
                <% elsif ai_provider_connection.provider == "gemini" %>
                  Inference, quota và giá của project vẫn đang chờ xác minh.
                <% elsif ai_provider_connection.provider == "codex" %>
                  Đã xác thực tài khoản; quyền model và quota chưa được xác minh.
                <% elsif ai_provider_connection.scope_missing? %>
                  Tài khoản chưa cấp quyền ChatGPT plan usage.
                <% else %>
                  Quyền và danh sách model áp dụng cho tài khoản này.
                <% end %>
              </p>
              <div class="card-actions justify-end">
                <%= link_to(ai_provider_connection.provider == "codex" ? "Xem xác thực" : "Quản lý model",
                            ai_provider_connection_path(ai_provider_connection), class: "btn btn-outline btn-sm") %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="card border border-dashed border-base-300 bg-base-100">
        <div class="card-body items-start">
          <h3 class="card-title">Chưa có tài khoản AI nào</h3>
          <p class="text-base-content/70">Chọn ChatGPT, Codex hoặc Gemini ở phía trên để kết nối. Antigravity hiện chưa được hỗ trợ.</p>
        </div>
      </div>
    <% end %>
  </section>
</section>
