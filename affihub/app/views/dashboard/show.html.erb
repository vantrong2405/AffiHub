<% content_for :title, "Tổng quan · Affihub" %>

<div class="space-y-8">
  <header class="flex flex-col gap-4 border-b border-border-strong pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium text-muted">KHÔNG GIAN LÀM VIỆC</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-foreground">Chào bạn, bắt đầu từ đây</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">Một nơi để chọn sản phẩm, duyệt nội dung và theo dõi bài đăng.</p>
    </div>
    <%= link_to "Mở kho sản phẩm", products_path, class: "inline-flex min-h-11 items-center justify-center rounded-xl bg-primary px-5 text-sm font-medium text-primary-foreground hover:bg-primary-hover" %>
  </header>

  <section class="grid gap-4 rounded-xl border border-border-strong bg-surface p-5 sm:grid-cols-[1fr_auto] sm:items-center sm:p-6" aria-labelledby="next-step-heading">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-muted">BƯỚC TIẾP THEO</p>
      <h2 id="next-step-heading" class="mt-2 text-lg font-semibold">Chọn sản phẩm để tạo nội dung</h2>
      <p class="mt-1 text-sm leading-6 text-muted">Sản phẩm đã nhập sẽ nằm trong kho. Bạn có thể tạo nhiều bản nháp và duyệt từng bản.</p>
    </div>
    <%= link_to "Đi đến kho sản phẩm", products_path, class: "inline-flex min-h-11 items-center justify-center rounded-xl border border-border-strong px-4 text-sm font-medium hover:bg-background" %>
  </section>

  <section aria-labelledby="connections-heading">
    <div class="mb-4 flex items-end justify-between gap-4">
      <div>
        <h2 id="connections-heading" class="text-lg font-semibold text-foreground">Kết nối dịch vụ</h2>
        <p class="mt-1 text-sm text-muted">Trạng thái các dịch vụ trong quy trình của bạn.</p>
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <%= render "connection_card", name: "Codex", detail: @ai_connection&.status_connected? ? "Sẵn sàng tạo nội dung" : "Cần kết nối để tạo nội dung", connected: @ai_connection&.status_connected?, path: ai_connection_path, action: @ai_connection&.status_connected? ? "Xem kết nối" : "Kết nối Codex" %>
      <%= render "connection_card", name: "ACCESSTRADE", detail: @affiliate_connection ? "Thông tin kết nối đã lưu" : "Cần kết nối để nhập sản phẩm", connected: @affiliate_connection.present?, state_label: (@affiliate_connection ? "Đã lưu token" : "Chưa kết nối"), path: new_affiliate_connection_path, action: @affiliate_connection ? "Quản lý kết nối" : "Kết nối ACCESSTRADE" %>
      <%= render "connection_card", name: "Facebook Page", detail: @social_connection ? "Tài khoản Facebook đã kết nối" : "Cần kết nối để đăng bài", connected: @social_connection.present?, path: social_connections_path, action: @social_connection ? "Quản lý Page" : "Kết nối Facebook" %>
    </div>
  </section>

  <section aria-labelledby="publications-heading">
    <div class="mb-4 flex items-end justify-between gap-4">
      <div>
        <h2 id="publications-heading" class="text-lg font-semibold text-foreground">Bài đăng gần đây</h2>
        <p class="mt-1 text-sm text-muted">Theo dõi kết quả từ Facebook Page.</p>
      </div>
    </div>

    <div class="overflow-hidden rounded-xl border border-border-strong bg-surface">
      <% if @recent_publications.any? %>
        <ul class="divide-y divide-border-strong">
          <% @recent_publications.each do |publication| %>
            <li class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <%= link_to publication.content.product.title.presence || "Nội dung sản phẩm", publication_path(publication), class: "block truncate text-sm font-medium text-foreground hover:underline" %>
                <p class="mt-1 text-xs text-muted"><%= publication.created_at.strftime("%d/%m/%Y · %H:%M") %> · <%= publication.social_destination.name %></p>
              </div>
              <span class="inline-flex w-fit rounded-full px-2.5 py-1 text-xs font-medium <%= publication_status_classes(publication.status) %>"><%= publication_status_label(publication.status) %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="px-5 py-10 text-center">
          <p class="text-sm font-medium text-foreground">Chưa có bài đăng nào</p>
          <p class="mt-1 text-sm text-muted">Bài đăng sẽ xuất hiện sau khi bạn duyệt nội dung và gửi tới Page.</p>
        </div>
      <% end %>
    </div>
  </section>
</div>
