<article class="rounded-xl border border-border-strong bg-surface p-5">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="font-semibold text-foreground"><%= name %></h3>
      <p class="mt-1 text-sm text-muted"><%= detail %></p>
    </div>
    <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium <%= connected ? "bg-emerald-50 text-emerald-700" : "bg-neutral-bg text-neutral" %>">
      <span aria-hidden="true" class="size-1.5 rounded-full <%= connected ? "bg-emerald-600" : "bg-neutral" %>"></span>
      <%= connected ? "Đã kết nối" : "Chưa kết nối" %>
    </span>
  </div>
  <%= link_to action, path, class: "mt-5 inline-flex min-h-10 items-center justify-center rounded-xl border border-border-strong bg-surface px-3.5 text-sm font-medium text-foreground hover:bg-button-hover" %>
</article>
