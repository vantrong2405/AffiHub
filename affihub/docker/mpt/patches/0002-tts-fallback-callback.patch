+def _request_rails_tts_fallback(request_id, narration, voice_name):
+    """Request approved Azure fallback audio from the Rails callback."""
+    callback_url = os.getenv("MPT_TTS_FALLBACK_CALLBACK_URL", "").strip()
+    callback_secret = os.getenv("MPT_TTS_CALLBACK_SECRET", "")
+    if not callback_url or not callback_secret or not request_id:
+        logger.warning(
+            "skip TTS fallback because callback configuration or request ID is missing"
+        )
+        return None
+
+    parsed_url = urlparse(callback_url)
+    if (
+        parsed_url.scheme not in {"http", "https"}
+        or not parsed_url.netloc
+        or parsed_url.username
+        or parsed_url.password
+        or parsed_url.fragment
+    ):
+        logger.warning("skip TTS fallback because callback URL is invalid")
+        return None
+
+    payload = {
+        "correlation_id": request_id,
+        "scene_index": 0,
+        "narration": narration,
+        "voice": voice_name,
+    }
+    raw_body = json.dumps(payload, ensure_ascii=False, separators=(",", ":")).encode(
+        "utf-8"
+    )
+    timestamp = str(int(time.time()))
+    signature = hmac.new(
+        callback_secret.encode("utf-8"),
+        timestamp.encode("utf-8") + b"." + raw_body,
+        hashlib.sha256,
+    ).hexdigest()
+
+    try:
+        response = requests.post(
+            callback_url,
+            data=raw_body,
+            headers={
+                "Content-Type": "application/json",
+                "X-MPT-Timestamp": timestamp,
+                "X-MPT-Signature": signature,
+            },
+            timeout=180,
+            allow_redirects=False,
+        )
+    except requests.RequestException as error:
+        logger.warning(
+            "TTS fallback callback request failed: "
+            f"request_id={request_id}, error={type(error).__name__}"
+        )
+        return None
+
+    content_type = (
+        response.headers.get("Content-Type", "").split(";", 1)[0].strip().lower()
+    )
+    if response.status_code != 200 or content_type != "audio/wav":
+        logger.warning(
+            "TTS fallback callback did not return audio: "
+            f"request_id={request_id}, status={response.status_code}, "
+            f"content_type={content_type or 'missing'}"
+        )
+        return None
+
+    audio_data = response.content
+    if (
+        len(audio_data) < 12
+        or audio_data[:4] != b"RIFF"
+        or audio_data[8:12] != b"WAVE"
+    ):
+        logger.warning(
+            f"TTS fallback callback returned invalid WAV: request_id={request_id}"
+        )
+        return None
+
+    return audio_data
 
 
