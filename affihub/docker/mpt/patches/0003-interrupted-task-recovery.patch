+    def mark_interrupted_tasks(self):
+        """Mark processing task records that have no persisted queue entry."""
+        queued_task_ids = set()
+        for task_json in self.redis_client.lrange(self.queue, 0, -1):
+            try:
+                task_info = json.loads(task_json)
+                task_id = task_info.get("kwargs", {}).get("task_id")
+            except (json.JSONDecodeError, AttributeError):
+                continue
+            if isinstance(task_id, str) and task_id:
+                queued_task_ids.add(task_id)
+
+        recovered = 0
+        page = 1
+        page_size = 1000
+        while True:
+            tasks, total = sm.state.get_all_tasks(page, page_size)
+            for task in tasks:
+                task_id = task.get("task_id")
+                if task.get("state") != const.TASK_STATE_PROCESSING:
+                    continue
+                if task_id in queued_task_ids or not isinstance(task_id, str):
+                    continue
+                recovered += bool(
+                    sm.state.patch_task(
+                        task_id,
+                        state=const.TASK_STATE_INTERRUPTED,
+                        failed_stage="mpt_restart",
+                        error="MPT restarted while the task was processing",
+                    )
+                )
+            if page * page_size >= total:
+                return recovered
+            page += 1
+
